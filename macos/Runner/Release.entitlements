<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The library lives in ~/Music; a sandboxed app cannot read it without
	     this, and the song list would simply come up empty. Read-write so the
	     Edit Info sheet can save corrected tags back into the files. -->
	<key>com.apple.security.assets.music.read-write</key>
	<true/>
	<!-- Outgoing connections, for looking lyrics up on lrclib.net. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The album list and covers the Raycast extension reads. Kept in the
	     real ~/Library/Application Support, since other apps cannot read
	     inside this app's container. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/Mewsic/</string>
	</array>
</dict>
</plist>
